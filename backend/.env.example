# ==============================================================================
# VAYORA Backend Environment Configuration (Template)
# Copy this file to backend/.env and configure your local settings.
# ==============================================================================

# Application Service URLs
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000

# Core Security & JWT Authentication
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Supabase Cloud / Local PostgreSQL / SQLite)
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
# Direct connection (IPv6):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# SQLite fallback:
# DATABASE_URL=sqlite:///./database/vayora.db

# Project Metadata
PROJECT_NAME="VAYORA - Your Digital Value, One Journey"
ENVIRONMENT=development
DEMO_EXCHANGE_RATE_USDT_INR=86.50

# ==============================================================================
# Real Email Delivery (SMTP Configuration)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=no-reply@vayora.network
SMTP_FROM_NAME="VAYORA Security & FinTech"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ==============================================================================
# Stripe Sandbox / Test Mode Payment Gateway
# ==============================================================================
STRIPE_MODE=sandbox
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
